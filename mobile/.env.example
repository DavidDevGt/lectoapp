# URL base del backend de LectoApp.
#
# En desarrollo puedes dejarla vacía: src/config/env.ts deduce la IP del servidor
# Metro para que un dispositivo físico con Expo Go alcance tu laptop por WiFi.
#
# En builds de release es OBLIGATORIA y debe ser HTTPS — la app lanza un error de
# arranque si falta o si usa http://. Los valores por perfil viven en eas.json.
EXPO_PUBLIC_API_URL=
