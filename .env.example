# ==============================================================================
# LectoApp — Plantilla de variables de entorno
# ==============================================================================
# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore
# y NUNCA debe commitearse.
#
#   cp .env.example .env
#
# Genera cada secreto con un valor aleatorio distinto:
#   openssl rand -base64 48
# ==============================================================================

# Server
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Base de datos PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=lectoapp
POSTGRES_DB=lectoapp
# Obligatorio. Sin valor por defecto: el stack no arranca si falta.
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# Secretos de autenticación — OBLIGATORIOS
# ------------------------------------------------------------------------------
# Mínimo 32 caracteres y DISTINTOS entre sí. Reutilizar el mismo valor para
# ambos permite presentar un refresh token como access token.
#
# Esto ya NO es solo documentación: src/config/env.ts lo verifica y el servidor
# se niega a arrancar si un secreto es corto, es igual al otro, o no tiene
# entropía real (por ejemplo 48 letras 'a').
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ------------------------------------------------------------------------------
# Dominio público y TLS
# ------------------------------------------------------------------------------
# Caddy es el único servicio con puertos publicados y termina TLS para este
# dominio, pidiendo el certificado a Let's Encrypt. Todo lo demás (backend,
# Postgres, Ollama, el nginx del panel) vive en la red interna de Docker.
#
# Usa `localhost` para pruebas locales: Caddy emite un certificado interno.
PUBLIC_DOMAIN=localhost
# Dirección de contacto para los avisos de expiración de Let's Encrypt.
ACME_EMAIL=admin@localhost

# Origen permitido del panel admin (CORS).
# Con la topología de compose.yml el panel y la API comparten origen a través de
# Caddy, así que CORS no interviene; esta variable solo importa si sirves el
# panel desde otro dominio.
ADMIN_CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Cadena de proxy
# ------------------------------------------------------------------------------
# Número EXACTO de proxies entre el cliente e Express, contados desde Express
# hacia fuera. compose.yml lo fija en 2 (Caddy -> nginx -> backend).
#
# Nunca lo pongas a `true` ni a un número mayor que los saltos reales: Express
# se creería una X-Forwarded-For escrita por el cliente y cualquiera podría
# falsificar su IP para saltarse el rate limiting.
#
# 0 = sin proxy (desarrollo con `pnpm dev`, se usa la IP del socket).
TRUST_PROXY_HOPS=0

# Marca `Secure` de la cookie de refresh. Si no se define, sigue a NODE_ENV.
# En producción no se puede poner a false: el servidor se niega a arrancar.
# COOKIE_SECURE=true

# ==============================================================================
# IA Local (Ollama) — servidor y modelo
# ==============================================================================
# Opción A — Ollama dentro de Docker (por defecto, recomendada):
OLLAMA_HOST=http://ollama:11434
#
# Opción B — Ollama en un servidor remoto de tu red local.
#   Sustituye el placeholder por la dirección de TU servidor y arranca con
#   el override correspondiente (ver ARCHITECTURE.md → Variantes de Despliegue).
# OLLAMA_HOST=http://TU_SERVIDOR_OLLAMA:11434
#
# Opción C — Ollama nativo en el mismo host que Docker (bare-metal):
# OLLAMA_HOST=http://host.docker.internal:11434

# Modelo a utilizar (ej: llama3.2, llama3.2, deepseek-r1:14b, mistral)
OLLAMA_MODEL=llama3.2
